<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.budgetapp.PrimaryController"
      style="-fx-background-color: #1e1e24;">

    <!-- ── MAIN ROW: left input panel + tree + graph ── -->
    <HBox spacing="20.0" VBox.vgrow="ALWAYS" style="-fx-background-color: #1e1e24;">
        <padding><Insets top="25" right="25" bottom="10" left="25"/></padding>
        <children>

            <!-- LEFT PANEL: inputs + budget entry -->
            <VBox spacing="15.0" minWidth="290.0" maxWidth="290.0"
                  style="-fx-background-color: #2a2a32; -fx-background-radius: 10; -fx-padding: 20;
                         -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 4);">
                <children>
                    <Label text="New Entry Details"
                           style="-fx-font-family: 'Bitcount Prop Single'; -fx-font-size: 22;
                                  -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>

                    <VBox spacing="5.0">
                        <Label text="[ Section Name ]"
                               style="-fx-font-family: 'Consolas','Courier New',monospace;
                                      -fx-text-fill: #a0a0a5; -fx-font-size: 13; -fx-font-weight: bold;"/>
                        <TextField fx:id="nameField" promptText="e.g., Groceries"
                                   style="-fx-background-color: #3a3a44; -fx-text-fill: white;
                                          -fx-prompt-text-fill: #707075; -fx-background-radius: 5;
                                          -fx-padding: 8; -fx-font-size: 13;"/>
                    </VBox>

                    <VBox spacing="5.0">
                        <Label text="[ Description ]"
                               style="-fx-font-family: 'Consolas','Courier New',monospace;
                                      -fx-text-fill: #a0a0a5; -fx-font-size: 13; -fx-font-weight: bold;"/>
                        <TextField fx:id="descField" promptText="Optional details..."
                                   style="-fx-background-color: #3a3a44; -fx-text-fill: white;
                                          -fx-prompt-text-fill: #707075; -fx-background-radius: 5;
                                          -fx-padding: 8; -fx-font-size: 13;"/>
                    </VBox>

                    <VBox spacing="5.0">
                        <Label text="[ Base Cost ($) ]"
                               style="-fx-font-family: 'Consolas','Courier New',monospace;
                                      -fx-text-fill: #a0a0a5; -fx-font-size: 13; -fx-font-weight: bold;"/>
                        <TextField fx:id="costField" promptText="0.00"
                                   style="-fx-background-color: #3a3a44; -fx-text-fill: white;
                                          -fx-prompt-text-fill: #707075; -fx-background-radius: 5;
                                          -fx-padding: 8; -fx-font-size: 13;"/>
                    </VBox>

                    <VBox spacing="5.0">
                        <Label text="[ Priority / Importance ]"
                               style="-fx-font-family: 'Consolas','Courier New',monospace;
                                      -fx-text-fill: #a0a0a5; -fx-font-size: 13; -fx-font-weight: bold;"/>
                        <ComboBox fx:id="importancePicker" promptText="Select Priority" maxWidth="Infinity"
                                  style="-fx-background-color: #3a3a44; -fx-text-fill: white;
                                         -fx-background-radius: 5; -fx-padding: 4; -fx-font-size: 13;"/>
                    </VBox>

                    <!-- ── BUDGET INPUT ── -->
                    <VBox spacing="5.0"
                          style="-fx-background-color: #1e1e2a; -fx-background-radius: 7; -fx-padding: 10;">
                        <Label text="[ Monthly Budget ($) ]"
                               style="-fx-font-family: 'Consolas','Courier New',monospace;
                                      -fx-text-fill: #7c3aed; -fx-font-size: 13; -fx-font-weight: bold;"/>
                        <TextField fx:id="budgetField" promptText="e.g. 3000"
                                   style="-fx-background-color: #3a3a44; -fx-text-fill: white;
                                          -fx-prompt-text-fill: #707075; -fx-background-radius: 5;
                                          -fx-padding: 8; -fx-font-size: 13;"/>
                        <Label fx:id="deficitLabel" text="" wrapText="true" maxWidth="250"/>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS"/>

                    <VBox spacing="10.0">
                        <Button text="Add Main Section" onAction="#handleAddSection" maxWidth="Infinity"
                                style="-fx-font-family: 'Bitcount Prop Single'; -fx-background-color: #c7277f;
                                       -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12;
                                       -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 16;"/>
                        <Button text="Add Selected Subsection" onAction="#handleAddSubsection" maxWidth="Infinity"
                                style="-fx-font-family: 'Bitcount Prop Single'; -fx-background-color: #e90ed7;
                                       -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12;
                                       -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 16;"/>
                    </VBox>
                </children>
            </VBox>

            <!-- MIDDLE PANEL: Tree View -->
            <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                <children>
                    <Label text="Budget Tree Workspace"
                           style="-fx-font-family: 'Bitcount Prop Single'; -fx-font-size: 24;
                                  -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
                    <Label text="&gt; Hover rows to delete. Select a row before adding a subsection."
                           style="-fx-font-family: 'Consolas','Courier New',monospace;
                                  -fx-text-fill: #8a8a93; -fx-font-size: 12;"/>
                    <TreeView fx:id="sectionListView" VBox.vgrow="ALWAYS"
                              style="-fx-background-color: #2a2a32; -fx-background-radius: 10;
                                     -fx-padding: 10; -fx-control-inner-background: #2a2a32;
                                     -fx-background-insets: 0;"/>
                </children>
            </VBox>

            <!-- RIGHT PANEL: Graph Canvas -->
            <VBox spacing="12.0" minWidth="320.0" HBox.hgrow="ALWAYS">
                <children>
                    <Label text="Graph View"
                           style="-fx-font-family: 'Bitcount Prop Single'; -fx-font-size: 24;
                                  -fx-font-weight: bold; -fx-text-fill: #ffffff;"/>
                    <Label text="&gt; Click nodes to expand/collapse. Drag freely."
                           style="-fx-font-family: 'Consolas','Courier New',monospace;
                                  -fx-text-fill: #8a8a93; -fx-font-size: 12;"/>
                    <Pane fx:id="graphCanvas" VBox.vgrow="ALWAYS"
                          style="-fx-background-color: #2a2a32; -fx-background-radius: 10;"/>
                </children>
            </VBox>

        </children>
    </HBox>

    <!-- ── BOTTOM: House savings progress bar ── -->
    <VBox spacing="6.0" style="-fx-background-color: #1e1e24; -fx-padding: 0 25 18 25;">
        <children>
            <Label fx:id="houseProgressLabel" text="🏠  House savings: $0 / $350,000  (0.0%)"
                   style="-fx-font-family: 'Consolas','Courier New',monospace;
                          -fx-text-fill: #a78bfa; -fx-font-size: 12;"/>

            <!-- Track -->
            <StackPane fx:id="houseProgressBarOuter" prefHeight="14.0" maxWidth="Infinity"
                       style="-fx-background-color: #2a2a32; -fx-background-radius: 7;">
                <children>
                    <!-- Fill — width controlled in Java -->
                    <Region fx:id="houseProgressBarFill" prefHeight="14.0" prefWidth="0.0"
                            StackPane.alignment="CENTER_LEFT"
                            style="-fx-background-color: linear-gradient(to right, #7c3aed, #a78bfa);
                                   -fx-background-radius: 7;"/>
                </children>
            </StackPane>
        </children>
    </VBox>

</VBox>
