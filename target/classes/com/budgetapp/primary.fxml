<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.budgetapp.PrimaryController">
   <children>
      <Label text="Add New Section" style="-fx-font-size: 18;" />
      <TextField fx:id="nameField" promptText="Name" />
      <TextField fx:id="descField" promptText="Description" />
      <TextField fx:id="costField" promptText="Base Cost" />
      <ComboBox fx:id="importancePicker" promptText="Importance" />
      <ComboBox fx:id="parentPicker" promptText="Select Parent (for subsections)" />
      <Button text="Add Section" onAction="#handleAddSection" maxWidth="Infinity"/>
      <Button text="Add Subsection" onAction="#handleAddSubsection" maxWidth="Infinity"/>
      <Label text="Current Sections:" />
      <!-- The ID here must match the @FXML variable in Java -->
      <TreeView fx:id="sectionListView" VBox.vgrow="ALWAYS" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
